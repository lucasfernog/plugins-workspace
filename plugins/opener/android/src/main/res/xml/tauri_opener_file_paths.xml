<?xml version="1.0" encoding="utf-8"?>
<!-- Directories `openPath` can share through `OpenerFileProvider`. Which files the webview may
     open is restricted by the plugin's `path` scope before a URI is ever created. -->
<paths>
  <files-path name="files" path="." />
  <cache-path name="cache" path="." />
  <external-files-path name="external_files" path="." />
  <external-cache-path name="external_cache" path="." />
  <external-path name="external" path="." />
  <!-- the app data directory (`$APPDATA`) is the parent of `files-path` -->
  <root-path name="root" path="." />
</paths>
